# The first date puzzles were available. Used to calculate #N puzzle number
# and to disable DateNav "previous" button before this date.
# Baked into the bundle at build time via Vite — update and rebuild when deploying.
VITE_APP_START_DATE=2026-05-12

# Optional: backend origin for split-domain deployments (e.g. Vercel + Railway).
# Leave unset (or empty) when frontend and backend are on the same origin.
# If set, the backend must also have CORS enabled for public routes (/api/problems/*, /api/health).
# IMPORTANT: /api/internal/* must NEVER get CORS headers regardless of this setting.
# VITE_API_BASE_URL=https://api.devdle.example.com
